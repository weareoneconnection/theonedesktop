{
  "name": "theone-desktop",
  "productName": "TheOne",
  "version": "0.4.2",
  "description": "TheOne for macOS and Windows: the OS surface plus a local agent runtime that works on folders on this computer.",
  "private": true,
  "main": "src/main.js",
  "author": "WAOC",
  "scripts": {
    "start": "electron .",
    "dev": "THEONE_DESKTOP_URL=http://localhost:3017 electron .",
    "bundle:runtime": "node scripts/bundle-runtime.mjs",
    "test": "node --test test/*.test.js",
    "e2e": "node test-e2e/run.mjs",
    "dist:mac": "npm run bundle:runtime && electron-builder --mac --arm64 --publish never -c.mac.identity=- -c.mac.hardenedRuntime=false -c.mac.notarize=false",
    "release:mac": "npm run bundle:runtime && electron-builder --mac --arm64 --publish always",
    "bundle:runtime:win": "node scripts/bundle-runtime.mjs --os=win32 --cpu=x64",
    "dist:win": "npm run bundle:runtime:win && electron-builder --win --x64 --publish never",
    "release:win": "npm run bundle:runtime:win && electron-builder --win --x64 --publish always"
  },
  "build": {
    "appId": "org.weareoneconnection.theone",
    "productName": "TheOne",
    "files": [
      "src/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources/oneclaw",
        "to": "oneclaw"
      }
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "hardenedRuntime": true,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "notarize": true
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon-win.png",
      "artifactName": "TheOne-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "TheOne",
      "deleteAppDataOnUninstall": false
    },
    "protocols": [
      {
        "name": "TheOne",
        "schemes": [
          "theone"
        ]
      }
    ],
    "directories": {
      "output": "release"
    },
    "afterPack": "scripts/after-pack.cjs",
    "publish": [
      {
        "provider": "github",
        "owner": "weareoneconnection",
        "repo": "theonedesktop",
        "releaseType": "release"
      }
    ]
  },
  "devDependencies": {
    "electron": "^44.4.1",
    "electron-builder": "^26.15.3",
    "javascript-obfuscator": "^5.8.0"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}
